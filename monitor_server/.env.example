# ---- Monitor Server .env ----

PORT=9000

# SOC Dashboard credentials (change before deploying!)
SOC_USER=soc_admin
SOC_PASS=changeme_in_env

# Log file path (can point to a shared EFS mount or S3-synced file in AWS)
LOG_FILE=honey_attack.log

# Shared secret for accepting log events from honey_server
LOG_SECRET=honey_internal_secret

# OpenAI API Key (for AI report generation)
OPENAI_API_KEY=sk-...
